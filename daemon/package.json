{
  "name": "bundeck-daemon",
  "version": "0.1.0",
  "description": "BunDeck daemon - Local server for StreamDeck-like functionality",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "cross-env DEV_MODE=true bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "dev:prod": "bun run --watch src/server.ts",
    "build": "node scripts/build.mjs",
    "build:win": "node scripts/build.mjs --win",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.9.0",
    "@elgato-stream-deck/node-lib": "^7.9.0",
    "@julusian/jpeg-turbo": "^3.1.0",
    "@napi-rs/canvas": "^1.2.1",
    "adm-zip": "^0.6.1",
    "chokidar": "^5.0.0",
    "lucide": "^1.83.0",
    "mime-types": "^3.0.2",
    "simple-icons": "^16.38.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.3",
    "werift": "^0.29.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/bun": "^1.4.5",
    "@types/mime-types": "^3.0.1",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.16.0",
    "prettier": "^3.10.1"
  },
  "keywords": [
    "streamdeck",
    "automation",
    "hotkeys",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "trustedDependencies": [
    "@julusian/jpeg-turbo",
    "node-hid"
  ]
}