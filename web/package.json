{
  "name": "libredeck-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint . --ext .astro,.js,.ts,.vue",
    "type-check": "astro check",
    "test": "vitest run",
