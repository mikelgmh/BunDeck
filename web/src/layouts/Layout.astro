---
export interface Props {
  title?: string;
}

const { title = 'BunDeck' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="BunDeck — panel de teclas físicas hecho en pantalla. Local, rápido y sin cuenta"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    <script is:inline>
      // Corrige <html lang> al idioma efectivo antes de hidratar:
      // guardado > detectado-soportado > inglés.
      try {
        var saved = localStorage.getItem('locale');
        var nav = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
        var base = String(nav).split('-')[0].toLowerCase();
        var lang = saved || (base === 'es' || base === 'en' ? base : 'en');
        document.documentElement.lang = lang;
      } catch (e) {
        document.documentElement.lang = 'en';
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
