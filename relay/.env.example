# Copia a .env y rellena. Nunca commitees el token real.
# Puerto: PORT tiene prioridad (openship/openpanel lo inyectan), si no RELAY_PORT (def 8787).
PORT=8787
# RELAY_PORT=8787

# Secreto compartido para conectar (WS ?token= / Authorization: Bearer / x-relay-token
# y POST /pair). Genera uno con: openssl rand -hex 32
RELAY_TOKEN=cambia-este-secreto

# Solo informativo para logs.
RELAY_DOMAIN=relay.bundeck.app

# Secreto de aprovisionamiento para auto-registro de daemons
# (POST /api/device-claim con Bearer). Vacío = claim deshabilitado (503).
# Genera uno con: openssl rand -hex 32
RELAY_PROVISION_TOKEN=
# Cuota de claims por IP: 200/día con ráfaga de 50/hora.
RELAY_CLAIM_PER_DAY=200
RELAY_CLAIM_BURST_PER_HOUR=50
# Tras rotar (POST /api/device-rotate) el token viejo sigue válido este
# tiempo en ms (def 5 min) y luego muere.
RELAY_ROTATE_GRACE_MS=300000

# Dónde vive relay.db (SQLite). En docker: /data (volumen PERSISTENTE, ver
# README "Despliegue a prueba de pérdida": sin volumen cada redespliegue
# invalida todas las sesiones; el arranque grita [FATAL almacenamiento]).
DATA_DIR=./data

# Ventana de gracia post-arranque para tokens/sids desconocidos (ms, def 90000):
# recién redesplegado responde 502 daemon-offline + Retry-After (reintentable)
# en vez de 401 definitivo, cubriendo el backoff de reconexión del daemon.
# RELAY_UNKNOWN_TOKEN_GRACE_MS=90000

# Rate-limit diferenciado (req/min por ventana 60s). /t/* por token de sesión.
RELAY_RATE_LIMIT_T=600
RELAY_RATE_LIMIT_UI=120
RELAY_RATE_LIMIT_WS=120
RELAY_RATE_LIMIT_PAIR=30
# Detrás de openship/traefik: respeta X-Forwarded-For para rate-limit.
TRUST_PROXY=1
